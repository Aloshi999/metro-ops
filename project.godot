[layer_names]

2d_render/layer_1="terrain"
2d_render/layer_2="zones"
2d_render/layer_3="roads"
2d_render/layer_4="services"
2d_render/layer_5="ui_world"
2d_physics/layer_1="map"

[physics]

common/physics_ticks_per_second=40

[rendering]

renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_2d=0
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/use_debanding=false
lights_and_shadows/directional_shadow/size=512
environment/defaults/default_clear_color=Color(0.12, 0.14, 0.16, 1)
scaling_3d/mode=2
scaling_3d/scale=0.67
scaling_3d/fsr_sharpness=0.2

[debug]

settings/fps/force_fps=40
