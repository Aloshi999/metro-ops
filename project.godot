; Engine configuration file.
; Metro Ops — Steam Deck city-builder (War room locked)

config_version=5

[application]

config/name="Metro Ops"
config/description="Steam Deck city-builder: RCI zones, roads, power/water, budget, war & disaster events. Aggregate sims only."
config/version="0.1.0-slice"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

